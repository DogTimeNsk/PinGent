# Copy this file to .env and set values for your own self-hosted installation.
PINGENT_TELEGRAM_BOT_TOKEN=
# JSON array with Telegram numeric IDs that may control this installation.
PINGENT_ALLOWED_TELEGRAM_USER_IDS=[]
# JSON array of existing absolute workspace paths. The first workspace is used by the MVP.
PINGENT_WORKSPACES=[]
# Optional local SQLite location and Codex CLI executable.
PINGENT_DATABASE_PATH=data/pingent.sqlite3
PINGENT_CODEX_BINARY=codex
# Optional Codex model override and timeout for Codex JSON-RPC responses (seconds).
PINGENT_CODEX_MODEL=
PINGENT_CODEX_REQUEST_TIMEOUT_SECONDS=30
# User-facing Telegram message locale (en or ru).
PINGENT_LOCALE=en
# The Web SPA server is disabled by default. Non-loopback hosts require
# PINGENT_WEB_ALLOW_REMOTE=true; configure TLS before exposing it to a network.
PINGENT_WEB_ENABLED=false
PINGENT_WEB_HOST=127.0.0.1
PINGENT_WEB_PORT=8080
PINGENT_WEB_ALLOW_REMOTE=false
# Required for a non-loopback bind. It requires HTTPS in the browser.
PINGENT_WEB_SECURE_COOKIES=false
# Optional trusted local external channel adapters. Each command is an argument
# array, never a shell command. See docs/adapter-extension.md.
PINGENT_EXTERNAL_ADAPTERS=[]
